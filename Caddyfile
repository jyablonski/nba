# ACME HTTP-01 needs :80 reachable. Grey-cloud DNS for baseline.jyablonski.dev.
# Optional ACME account email: set CADDY_EMAIL on the caddy service.
# Caddy requires `{` to be the last token on its line — one-line handle blocks
# do not parse. Check with `caddy validate --config Caddyfile` before deploying.
# nbadashboard.jyablonski.dev redirects to baseline; see the block at the
# bottom and docs/plans/oci-caddy-hosting.md.

baseline.jyablonski.dev {
	encode gzip zstd

	# MUST precede /api/* — NextAuth serves the GitHub OAuth routes from the
	# Next.js app at /api/auth/*, so sending them to FastAPI would 404 the
	# callback and break admin sign-in in production. The API has no /api/auth
	# routes, so nothing is shadowed on that side.
	handle /api/auth/* {
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	# MCP over the existing certificate instead of plain HTTP on 8001. Clients
	# send Authorization: Bearer $MCP_API_TOKEN, so the transport has to be TLS —
	# on 8001 that token crossed the wire in the clear.
	# flush_interval -1 disables response buffering: Streamable HTTP replies can
	# be SSE streams, and a buffering proxy would stall them.
	handle /mcp* {
		reverse_proxy mcp:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Legacy hostname. Kept here rather than as a Cloudflare Bulk Redirect so the
# rule is version-controlled beside the site it points at.
#
# 308 not 301: 308 forbids a client from rewriting the method, so a POST to the
# old host replays as a POST. `redir ... permanent` is 301, which historically
# lets clients downgrade POST to GET.
#
# {uri} is path + query, so /example?source=legacy survives the hop. Using
# {path} instead would silently drop query strings.
#
# No reverse_proxy here on purpose: legacy traffic must not reach the old
# dashboard service. Nothing loops, because this block only matches the legacy
# host and every redirect it emits targets a different one.
#
# Caddy issues a separate Let's Encrypt certificate for this name via the same
# on-demand ACME path as baseline. That needs the nbadashboard DNS record
# pointing at this VM (grey-cloud) and :80 reachable for HTTP-01 — until DNS
# moves, this block parses fine and simply never gets hit.
nbadashboard.jyablonski.dev {
	redir https://baseline.jyablonski.dev{uri} 308
}
